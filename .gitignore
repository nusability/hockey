.DS_Store

# iOS — the .xcodeproj is generated by xcodegen from ios/project.yml; build output is regenerable
ios/*.xcodeproj/
ios/build*/
DerivedData/

# Android — build output and machine-local SDK config (a different path on every machine)
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.kotlin/

# Signing and release artefacts: referenced, never committed (AGENTS safety)
*.mobileprovision
*.p12
*.jks
*.keystore
android/keystore.properties
build-release/

# Worktrees created by EnterWorktree — local scratch
.claude/worktrees/
.claude/settings.local.json

# Device captures and parity-rig output — throwaway
.parity/

__pycache__/
*.pyc
node_modules/
ios/Info.plist

# Telemetry configuration: the endpoint and the ingest token, per machine. The committed
# .example files say what goes in them; with them absent the client is inert (spec §18.7).
ios/Telemetry.xcconfig
android/telemetry.properties
