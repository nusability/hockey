// The sky dome: the palette texture's gradient, unlit (ADR 0005 — the sky is part of the scene, not
// a view background; ADR 0006 — no tint, no fog). The twin of iOS's sky UnlitMaterial.
material {
    name : sky,
    shadingModel : unlit,
    parameters : [
        { type : sampler2d, name : baseColorMap }
    ],
    requires : [ uv0 ],
    culling : none
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // glTF's V runs down the image; Filament samples with V up — the same flip every
        // platform applies to the shared palette (world.mat).
        float2 uv = getUV0();
        uv.y = 1.0 - uv.y;
        material.baseColor = texture(materialParams_baseColorMap, uv);
    }
}
