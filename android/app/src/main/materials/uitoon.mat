// The 3D UI's toon colour (ADR 0006; the twin of iOS's UIToon shader graph in Materials.swift):
// toon.mat's formula read from the **object's own normal** instead of the world's. A menu stands
// facing whichever camera pose its screen uses and the HUD hangs off the moving match camera, so a
// key fixed in the world falls on a different face of every screen and leaves most of them in the
// dark band — "washed out, in their own shadow". In the UI's own frame +Z is always the face the
// player looks at, +Y its top and ±X its sides, so design.json's light means what it says on every
// screen, and nothing has to be rewritten as the camera moves. The formula, unchanged:
//   colour = albedo × (mix(ground, sky, 0.5 + 0.5·n.y) + sun · (n·l > 0.4 ? 1 : shade))
// `shade` is the band's dark side, a share of the sun: a world keeps the prototype's 0.7, the 3D
// UI's own light drops much lower so an extruded letter's sides read as a bevel (design.json).
// Every colour linear, sky, ground and sun already carrying their strengths. `alpha` lets the 3D UI
// fade a block; a solid instance (alpha 1) sets depth writes on (Materials, the UI kit's Palette).
material {
    name : uitoon,
    shadingModel : unlit,
    parameters : [
        { type : float3, name : albedo },
        { type : float3, name : sky },
        { type : float3, name : ground },
        { type : float3, name : sun },
        { type : float3, name : sunDirection },
        { type : float, name : shade },
        { type : float, name : alpha }
    ],
    variables : [ shadingNormal ],
    requires : [ tangents ],
    blending : transparent,
    culling : back
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        highp vec3 n;
        toTangentFrame(mesh_tangents, n);
        material.shadingNormal = vec4(n, 0.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        float3 n = normalize(variable_shadingNormal.xyz);
        float3 hemi = mix(materialParams.ground, materialParams.sky, 0.5 + 0.5 * n.y);
        float band = dot(n, materialParams.sunDirection) > 0.4 ? 1.0 : materialParams.shade;
        float3 colour = materialParams.albedo * (hemi + materialParams.sun * band);
        material.baseColor = vec4(colour * materialParams.alpha, materialParams.alpha);
    }
}
