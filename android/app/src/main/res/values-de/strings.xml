    <string name="drill_moving_name">Wandernde Hütchen</string>
    <string name="drill_moving_hint">Die Dummys gleiten hin und her. Passe im richtigen Moment durch die Lücken.</string>
    <string name="drill_sleepy_name">Schläfrige Verteidiger</string>
    <string name="drill_sleepy_hint">Diese Verteidiger jagen den Ball, aber langsam. Erreicht einer deinen Ballführer, klaut er ihn – also weiterpassen.</string>
    <string name="drill_press_name">Unter Druck</string>
    <string name="drill_press_hint">Drei echte Verteidiger mit Dreivierteltempo. Schnelle Pässe schlagen jedes Pressing.</string>
    <string name="drill_scrimmage_name">Trainingsspiel</string>
