    <string name="drill_shot_name">Erster Schuss</string>
    <string name="drill_shot_hint">Irgendwo tippen und halten: Der Ball kreist um deinen Spieler. Hebe den Finger, wenn der Pfeil aufs Tor zeigt.</string>
    <string name="drill_pass_name">Doppelpass</string>
    <string name="drill_pass_hint">Hebe den Finger, wenn der Pfeil auf deinen Mitspieler zeigt, um zu passen. Tore zählen nur nach einem Pass.</string>
    <string name="drill_goalie_name">Torwart überwinden</string>
    <string name="drill_goalie_hint">Der Torwart folgt dem Ball. Schieße früh oder spiele quer, um den Torwart aus der Position zu locken.</string>
    <string name="drill_cones_name">Hütchen</string>
