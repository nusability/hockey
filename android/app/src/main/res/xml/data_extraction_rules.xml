<?xml version="1.0" encoding="utf-8"?>
<!--
  What leaves this phone on API 31 and up (spec §17.1, ADR 0009) — the same list as
  backup_rules.xml, which older releases read, stated for both routes off the device: a cloud
  backup and a direct device-to-device transfer.

  Exclude-only, so save.json is backed up and transferred like everything else the app writes
  (player progress is sacred, principle 13). device.json is neither: an install id restored onto a
  second phone is one install counted as two, forever.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="device.json" />
        <exclude domain="file" path="device.json.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="device.json" />
        <exclude domain="file" path="device.json.tmp" />
    </device-transfer>
</data-extraction-rules>
