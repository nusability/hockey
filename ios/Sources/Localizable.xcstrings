    "formation.wide.blurb" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flügel kleben an den Seitenlinien. Zieht das Feld für lange Bälle auseinander."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wingers hug the sidelines. Stretches the pitch for long balls."
          }
        }
