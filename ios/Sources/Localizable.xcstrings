        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei hinten, drei vorne. Die Allrounder-Aufstellung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two at the back, three up front. The all-round shape."
          }
        }
      }
    },
    "formation.balanced.name" : {
