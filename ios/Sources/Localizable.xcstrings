    "formation.defensive.blurb" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei hinten. Schwer zu knacken, langsamer im Angriff."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
