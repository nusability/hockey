    "help.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Spieler laufen von selbst. Du entscheidest nur, wann der Ball losgelassen wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your players run on their own. You only decide when to let go of the ball."
          }
        }
      }
    },
    "help.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat einer deiner Spieler den Ball, kreist er um ihn herum, und ein Pfeil zeigt, wohin er fliegen würde. Irgendwo tippen und halten, um ihn zu behalten; Finger heben, um ihn abzuspielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When one of your players has the ball it circles around them, and an arrow shows where it would go. Touch and hold anywhere to keep it; lift your finger to send it."
          }
        }
      }
    },
    "help.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Pfeil wird grün, wenn er auf einen Mitspieler zeigt (Pass), und pink, wenn er aufs Tor zeigt (Schuss). Loslassen in der Nähe eines Ziels rastet ein, du musst also nicht exakt sein. Der Ball dreht sich zuerst zum nützlichsten Ziel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The arrow turns green when it points at a team-mate (a pass) and pink when it points at the goal (a shot). Releasing near a target snaps to it, so you don't need to be exact. The ball spins towards the most useful target first."
          }
        }
      }
    },
    "help.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verteidiger, die deinen Ballführer erreichen, stehlen den Ball. Halte ihn in Bewegung: passen, passen, schießen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defenders who reach your carrier steal the ball. Keep it moving: pass, pass, shoot."
          }
        }
      }
    },
    "help.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginne mit dem Training: Die ersten Übungen haben keine Gegner, dann Dummys, dann Verteidiger, die mit jedem Level schneller werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start with Training: the first drills have no opponents, then dummies, then defenders that get faster each level."
          }
        }
      }
    },
    "help.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Saison hat eine Liga und einen Pokal, gespielt in fünf Welten. Das automatische Spiel deines Teams folgt der Taktik auf der Trainertafel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The season has a league and a cup, played in five worlds. Your team's automatic play follows the tactics on the coach's board."
          }
        }
      }
    },
