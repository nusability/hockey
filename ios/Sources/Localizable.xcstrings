    "drill.cones.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dummys blocken Pässe und Schüsse. Spiele den Ball um sie herum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dummies block passes and shots. Move the ball around them."
