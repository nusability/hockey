    "drill.sleepy.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Verteidiger jagen den Ball, aber langsam. Erreicht einer deinen Ballführer, klaut er ihn – also weiterpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These defenders chase the ball, slowly. If one reaches your carrier they steal it, so keep passing."
