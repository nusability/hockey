        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moving cones"
          }
        }
      }
    },
    "drill.pass.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebe den Finger, wenn der Pfeil auf deinen Mitspieler zeigt, um zu passen. Tore zählen nur nach einem Pass."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lift when the arrow points at your team-mate to pass. Goals only count after a pass."
          }
        }
      }
    },
    "drill.pass.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelpass"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give and go"
          }
        }
      }
    },
    "drill.press.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei echte Verteidiger mit Dreivierteltempo. Schnelle Pässe schlagen jedes Pressing."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three real defenders at three-quarter speed. Quick passes beat pressure."
          }
        }
      }
    },
    "drill.press.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter Druck"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under pressure"
          }
        }
      }
    },
    "drill.scrimmage.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein echtes Spiel: Die anderen greifen auch an. Erziele drei Tore, bevor die Zeit abläuft, und du bist bereit für die Liga."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A real game: they attack too. Score three before the clock runs out and you are ready for the league."
          }
        }
      }
    },
    "drill.scrimmage.name" : {
      "extractionState" : "manual",
      "localizations" : {
