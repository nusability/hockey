          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beat the goalie"
          }
        }
      }
    },
    "drill.moving.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dummys gleiten hin und her. Passe im richtigen Moment durch die Lücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dummies slide back and forth. Time your passes through the gaps."
          }
        }
      }
    },
    "drill.moving.name" : {
      "extractionState" : "manual",
      "localizations" : {
