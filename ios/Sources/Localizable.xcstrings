    "drill.cones.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dummys blocken Pässe und Schüsse. Spiele den Ball um sie herum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dummies block passes and shots. Move the ball around them."
          }
        }
      }
    },
    "drill.cones.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hütchen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cones"
          }
        }
      }
    },
    "drill.goalie.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Torwart folgt dem Ball. Schieße früh oder spiele quer, um den Torwart aus der Position zu locken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goalie follows the ball. Shoot early, or pass across to pull the goalie out of position."
          }
        }
      }
    },
    "drill.goalie.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torwart überwinden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beat the goalie"
          }
        }
      }
    },
    "drill.moving.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dummys gleiten hin und her. Passe im richtigen Moment durch die Lücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dummies slide back and forth. Time your passes through the gaps."
          }
        }
      }
    },
    "drill.moving.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wandernde Hütchen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moving cones"
          }
        }
      }
    },
    "drill.pass.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebe den Finger, wenn der Pfeil auf deinen Mitspieler zeigt, um zu passen. Tore zählen nur nach einem Pass."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lift when the arrow points at your team-mate to pass. Goals only count after a pass."
          }
        }
      }
    },
    "drill.pass.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelpass"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give and go"
          }
        }
      }
    },
    "drill.press.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei echte Verteidiger mit Dreivierteltempo. Schnelle Pässe schlagen jedes Pressing."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three real defenders at three-quarter speed. Quick passes beat pressure."
          }
        }
      }
    },
    "drill.press.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter Druck"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under pressure"
          }
        }
      }
    },
    "drill.scrimmage.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein echtes Spiel: Die anderen greifen auch an. Erziele drei Tore, bevor die Zeit abläuft, und du bist bereit für die Liga."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A real game: they attack too. Score three before the clock runs out and you are ready for the league."
          }
        }
      }
    },
    "drill.scrimmage.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainingsspiel"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrimmage"
          }
        }
      }
    },
    "drill.shot.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irgendwo tippen und halten: Der Ball kreist um deinen Spieler. Hebe den Finger, wenn der Pfeil aufs Tor zeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold anywhere: the ball circles your player. Lift your finger when the arrow points at the goal."
          }
        }
      }
    },
    "drill.shot.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erster Schuss"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First shot"
          }
        }
      }
    },
    "drill.sleepy.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Verteidiger jagen den Ball, aber langsam. Erreicht einer deinen Ballführer, klaut er ihn – also weiterpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These defenders chase the ball, slowly. If one reaches your carrier they steal it, so keep passing."
          }
        }
      }
    },
    "drill.sleepy.name" : {
