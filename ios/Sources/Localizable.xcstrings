    "drill.goalie.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Torwart folgt dem Ball. Schieße früh oder spiele quer, um den Torwart aus der Position zu locken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goalie follows the ball. Shoot early, or pass across to pull the goalie out of position."
          }
        }
      }
    },
    "drill.goalie.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
